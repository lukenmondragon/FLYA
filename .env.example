# ─────────────────────────────────────────────────────────────────────────────
# FLYA · variables de entorno
# Copia este archivo a .env.local y rellena lo que tengas. SIN NINGUNA CLAVE la app
# arranca igualmente con datos de demostración y el intérprete por reglas.
# Todas son de servidor: NUNCA uses el prefijo NEXT_PUBLIC_ para claves.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proveedor de vuelos ──────────────────────────────────────────────────────
# auto = Travelpayouts si hay token; si no, mock (demostración).
# Valores: auto | mock | travelpayouts
FLIGHT_PROVIDER=auto

# Travelpayouts / Aviasales Data API (gratis con cuenta de afiliado).
# Token: https://app.travelpayouts.com → Perfil → API token
TRAVELPAYOUTS_TOKEN=
# Tu "marker" de afiliado (número). Se añade a los enlaces de compra.
TRAVELPAYOUTS_MARKER=
# Dominio de Aviasales para los enlaces (p. ej. www.aviasales.com, www.aviasales.es)
TRAVELPAYOUTS_LINK_HOST=www.aviasales.com
# Mercado de datos opcional (p. ej. es, mx, us). Vacío = por defecto del proveedor.
TRAVELPAYOUTS_MARKET=

# ── LLM ──────────────────────────────────────────────────────────────────────
# auto = Claude si hay ANTHROPIC_API_KEY; si no, Gemini si hay GEMINI_API_KEY; si no, reglas.
# Valores: auto | anthropic | gemini | rules
LLM_PROVIDER=auto
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# https://aistudio.google.com/apikey (plan gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Se prueban en orden si el principal está saturado (503) o no disponible.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# ── Base de datos ───────────────────────────────────────────────────────────
# Local: SQLite en archivo. Vercel: postgres://... (Neon/Supabase) o libsql://... (Turso).
# "memory:" = sin persistencia.
DATABASE_URL=file:.data/vuelos.db
# Solo para Turso (libsql://)
DATABASE_AUTH_TOKEN=

# ── Búsqueda ─────────────────────────────────────────────────────────────────
# Moneda si el origen no la determina (MXN se usa automáticamente si sales de México).
DEFAULT_CURRENCY=EUR
MAX_ORIGIN_AIRPORTS=6
MAX_DESTINATION_AIRPORTS=6
# Tope de llamadas al proveedor por consulta y presupuesto diario total (0 = sin límite).
MAX_PROVIDER_CALLS_PER_QUERY=16
DAILY_PROVIDER_CALL_BUDGET=2000
PROVIDER_CONCURRENCY=4
# Caducidad de la caché de búsquedas (minutos).
CACHE_TTL_MINUTES=180

# ── Protección de cuota ─────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=120

# ── Monetización / analítica (desactivadas) ─────────────────────────────────
ADS_ENABLED=false
ANALYTICS_ENABLED=false

# ── Logs: debug | info | warn | error | silent ──────────────────────────────
LOG_LEVEL=info
